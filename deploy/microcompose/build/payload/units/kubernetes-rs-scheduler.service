[Unit]
Description=kubernetes-rs scheduler
After=kubernetes-rs-api-server.service
ConditionPathExists=/usr/local/bin/scheduler
[Service]
Environment=RUST_LOG=info
# Flags mirror manifests/control-plane/kube-scheduler.yaml.
ExecStart=/usr/local/bin/scheduler --api-server-url https://api-server:6443 --kubeconfig /etc/kubernetes-rs/pki/scheduler.conf --interval 1
Restart=always
[Install]
WantedBy=multi-user.target
